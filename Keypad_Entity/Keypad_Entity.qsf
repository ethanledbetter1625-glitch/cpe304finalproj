set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY Keypad_Entity
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "10:59:51  NOVEMBER 06, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_location_assignment PIN_AF16 -to column[2]
set_location_assignment PIN_AG16 -to column[1]
set_location_assignment PIN_AH18 -to column[0]
set_location_assignment PIN_AA14 -to reset
set_location_assignment PIN_AA18 -to row[0]
set_location_assignment PIN_AE17 -to row[1]
set_location_assignment PIN_AH19 -to row[2]
set_location_assignment PIN_AH20 -to row[3]
set_location_assignment PIN_AF14 -to clk
set_location_assignment PIN_AE26 -to disp1[0]
set_location_assignment PIN_AE27 -to disp1[1]
set_location_assignment PIN_AE28 -to disp1[2]
set_location_assignment PIN_AG27 -to disp1[3]
set_location_assignment PIN_AF28 -to disp1[4]
set_location_assignment PIN_AG28 -to disp1[5]
set_location_assignment PIN_AH28 -to disp1[6]
set_location_assignment PIN_AJ29 -to disp2[0]
set_location_assignment PIN_AH29 -to disp2[1]
set_location_assignment PIN_AH30 -to disp2[2]
set_location_assignment PIN_AG30 -to disp2[3]
set_location_assignment PIN_AF29 -to disp2[4]
set_location_assignment PIN_AF30 -to disp2[5]
set_location_assignment PIN_AD27 -to disp2[6]
set_location_assignment PIN_V16 -to LED
set_global_assignment -name VHDL_FILE ../Key_Decode_Entity/Key_Decode_Entity.vhd
set_global_assignment -name VHDL_FILE ../Shift_Reg_Entity/Shift_Reg_Entity.vhd
set_global_assignment -name VHDL_FILE seven_seg_decode.vhd
set_global_assignment -name VHDL_FILE Keypad_Entity.vhd
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top